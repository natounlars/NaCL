<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.6"/>

  <object class="AdwApplicationWindow" id="launcher_window">
    <property name="title">Minecraft 启动器</property>
    <property name="default-width">1000</property>
    <property name="default-height">720</property>

      <property name="content">
    <object class="AdwToastOverlay" id="global_toast_overlay">
      <property name="child">
        <object class="AdwToolbarView">
          <child type="top">
            <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwViewSwitcher">
                <property name="stack">view_stack</property>
                <property name="policy">wide</property>
              </object>
            </property>
          </object>
        </child>

        <property name="content">
          <object class="AdwViewStack" id="view_stack">

            <!-- Tab 1：启动 -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">launch</property>
                <property name="title" translatable="yes">启动</property>
                <property name="icon-name">media-playback-start-symbolic</property>
                <property name="child">
                  <object class="AdwPreferencesPage">
                    <property name="title" translatable="yes">启动</property>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">账户</property>
                        <child>
                          <object class="AdwActionRow" id="account_row">
                            <property name="title">Steve</property>
                            <property name="subtitle" translatable="yes">Microsoft 账户 · 已登录</property>
                            <property name="activatable">True</property>
                            <child type="prefix">
                              <object class="GtkImage">
                                <property name="icon-name">avatar-default-symbolic</property>
                                <property name="pixel-size">32</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
  <object class="AdwPreferencesGroup">
    <property name="title" translatable="yes">游戏实例</property>
    <child>
      <object class="AdwComboRow" id="instance_row">
        <property name="title" translatable="yes">当前实例</property>
      </object>
    </child>
    <child>
      <object class="AdwActionRow" id="manage_instances_row">
        <property name="title" translatable="yes">管理实例</property>
        <property name="subtitle" translatable="yes">搜索、新建或导入 .minecraft 文件夹</property>
        <property name="activatable">True</property>
        <child type="end">
          <object class="GtkImage">
            <property name="icon-name">go-next-symbolic</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwSwitchRow" id="instance_isolation_switch">
        <property name="title" translatable="yes">启用实例隔离</property>
        <property name="subtitle" translatable="yes">Mod、存档、配置独立存储</property>
        <property name="active">True</property>
      </object>
    </child>
  </object>
</child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">运行配置</property>
                        <child>
                          <object class="AdwComboRow" id="java_combo">
                            <property name="title" translatable="yes">Java 运行时</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="memory_spin">
                            <property name="title" translatable="yes">最大内存</property>
                            <property name="subtitle" translatable="yes">MB</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">512</property>
                                <property name="upper">32768</property>
                                <property name="step-increment">256</property>
                                <property name="value">4096</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">游戏目录</property>
                            <property name="subtitle">~/.local/share/mc-launcher/instances/</property>
                            <property name="activatable">True</property>
                            <child type="end">
                              <object class="GtkImage">
                                <property name="icon-name">folder-open-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="GtkButton" id="launch_button">
                            <property name="label" translatable="yes">启动游戏</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <style>
                              <class name="suggested-action"/>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- Tab 2：Mod -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">mods</property>
                <property name="title" translatable="yes">Mod</property>
                <property name="icon-name">application-x-addon-symbolic</property>
                <property name="child">
                  <object class="AdwPreferencesPage">
                    <property name="title" translatable="yes">Mod 管理</property>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwActionRow" id="mod_current_instance_row">
                            <property name="title" translatable="yes">当前实例</property>
                            <property name="subtitle" translatable="yes">-</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwEntryRow" id="mod_search">
                            <property name="title" translatable="yes">搜索 Mod</property>
                            <property name="show-apply-button">False</property>
                            <child type="prefix">
                              <object class="GtkImage">
                                <property name="icon-name">system-search-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup" id="mod_list_group">
                        <property name="title" translatable="yes">已安装</property>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">打开 Mod 文件夹</property>
                            <property name="activatable">True</property>
                            <child type="end">
                              <object class="GtkImage">
                                <property name="icon-name">folder-open-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- Tab 3：下载 -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">download</property>
                <property name="title" translatable="yes">下载</property>
                <property name="icon-name">folder-download-symbolic</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="title-widget">
                          <object class="AdwViewSwitcher">
                            <property name="policy">wide</property>
                            <property name="stack">download_stack</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="AdwToastOverlay" id="download_toast_overlay">
                        <property name="child">
                          <object class="AdwViewStack" id="download_stack">

                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">release</property>
                                <property name="title" translatable="yes">正式版</property>
                                <property name="icon-name">emblem-default-symbolic</property>
                                <property name="child">
                                  <object class="AdwPreferencesPage">
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <child>
                                          <object class="AdwEntryRow" id="release_search">
                                            <property name="title" translatable="yes">搜索正式版</property>
                                            <property name="show-apply-button">False</property>
                                            <child type="prefix">
                                              <object class="GtkImage">
                                                <property name="icon-name">system-search-symbolic</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="release_versions_group">
                                        <property name="title" translatable="yes">可用版本</property>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">正在加载…</property>
                                            <child type="prefix">
                                              <object class="AdwSpinner"/>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">snapshot</property>
                                <property name="title" translatable="yes">预览版</property>
                                <property name="icon-name">applications-science-symbolic</property>
                                <property name="child">
                                  <object class="AdwPreferencesPage">
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <child>
                                          <object class="AdwEntryRow" id="snapshot_search">
                                            <property name="title" translatable="yes">搜索预览版</property>
                                            <property name="show-apply-button">False</property>
                                            <child type="prefix">
                                              <object class="GtkImage">
                                                <property name="icon-name">system-search-symbolic</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="snapshot_versions_group">
                                        <property name="title" translatable="yes">可用版本</property>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">正在加载…</property>
                                            <child type="prefix">
                                              <object class="AdwSpinner"/>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">old</property>
                                <property name="title" translatable="yes">远古版</property>
                                <property name="icon-name">document-open-recent-symbolic</property>
                                <property name="child">
                                  <object class="AdwPreferencesPage">
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <child>
                                          <object class="AdwEntryRow" id="old_search">
                                            <property name="title" translatable="yes">搜索远古版</property>
                                            <property name="show-apply-button">False</property>
                                            <child type="prefix">
                                              <object class="GtkImage">
                                                <property name="icon-name">system-search-symbolic</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="old_versions_group">
                                        <property name="title" translatable="yes">可用版本</property>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">正在加载…</property>
                                            <child type="prefix">
                                              <object class="AdwSpinner"/>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <child>
                              <object class="AdwViewStackPage">
                                <property name="name">fool</property>
                                <property name="title" translatable="yes">愚人节版</property>
                                <property name="icon-name">face-smile-symbolic</property>
                                <property name="child">
                                  <object class="AdwPreferencesPage">
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <child>
                                          <object class="AdwEntryRow" id="fool_search">
                                            <property name="title" translatable="yes">搜索愚人节版</property>
                                            <property name="show-apply-button">False</property>
                                            <child type="prefix">
                                              <object class="GtkImage">
                                                <property name="icon-name">system-search-symbolic</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="fool_versions_group">
                                        <property name="title" translatable="yes">可用版本</property>
                                        <child>
                                          <object class="AdwActionRow">
                                            <property name="title" translatable="yes">正在加载…</property>
                                            <child type="prefix">
                                              <object class="AdwSpinner"/>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>

                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Tab 4：设置 -->
            <child>
              <object class="AdwViewStackPage">
                <property name="name">settings</property>
                <property name="title" translatable="yes">设置</property>
                <property name="icon-name">preferences-system-symbolic</property>
                <property name="child">
                  <object class="AdwPreferencesPage">
                    <property name="title" translatable="yes">设置</property>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">账户</property>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">管理账户</property>
                            <property name="subtitle" translatable="yes">切换或退出 Microsoft 账户</property>
                            <property name="activatable">True</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Java</property>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">全局 Java 路径</property>
                            <property name="subtitle">/usr/lib/jvm/java-21-openjdk</property>
                            <property name="activatable">True</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">启动器</property>
                        <child>
                          <object class="AdwSwitchRow">
                            <property name="title" translatable="yes">启动游戏后隐藏窗口</property>
                            <property name="active">False</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

          </object>
        </property>
        </object>
            </property>
      </object>
    </property>
  </object>
</interface>